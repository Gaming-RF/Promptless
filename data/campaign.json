			"mv_usage": "usage: mv FILE DEST",
			"read_usage": "usage: {cmd} FILE"
		},
		"ui": {
			"attach_none": "attach: none (use SNAP)",
			"attach_some": "attach: {name}",
			"send": "Send",
			"snap": "SNAP",
			"reply_prefix": "Re: ",
			"music_on": "music: on",
			"music_off": "music: off"
		}
	}
}