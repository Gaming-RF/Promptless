				"      history alias ps clear mv",
				"Tab completes. Up/Down = history."
			],
			"viewer": "pixview",
			"alias": [
				"alias open='pixview'   # set up by the previous owner"
			],
			"cat_picture": "{cmd}: {file}: that's a picture. try open",
